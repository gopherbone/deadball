{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "deadball",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "LEAGUE", "class_name": "League" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["League"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deadball",
      // replace with the real id from `wrangler d1 create deadball` (see docs/DEPLOY.md)
      "database_id": "290638e9-9dd5-49be-b14c-a982b79da17d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "deadball-logs" }],
  "vars": {
    "GAME_DAY_MS": "1800000",
    "WORLD_SEED": "deadball-1",
    // oldest Playdate build (pdxinfo buildNumber, sent as X-Build) allowed online; older builds
    // get 426 upgrade_required. Bump together with playdate/source/pdxinfo every release.
    "MIN_BUILD": "5"
  },
  // safety net: makes sure the League DO is awake and its alarm is armed
  "triggers": { "crons": ["*/10 * * * *"] },
  "limits": { "cpu_ms": 300000 }
}
